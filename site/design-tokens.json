{
  "$schema": "design tokens for בית הפרספקס · הזמנה אונליין. Source: docs/brand-brief-HE.md. No colors beyond this file.",
  "brand": { "name": "בית הפרספקס", "sub": "הזמנה אונליין", "title": "בית הפרספקס · הזמנה אונליין", "logo": "assets/logo-perspexhouse.png", "logo_height_mobile_px": 40 },
  "color": {
    "bg": "#ffffff",
    "bg2": "#f7f7f7",
    "fg": "#313131",
    "muted": "#626262",
    "line": "#d1d1d1",
    "primary": "#1cb3cf",
    "primary_dark": "#08485d",
    "accent": "#f26554",
    "success": "#086862",
    "whatsapp": "#25d366",
    "on_primary": "#ffffff",
    "glass_fill": "rgba(28,179,207,0.14)",
    "glass_stroke": "#1cb3cf"
  },
  "font": {
    "family": "Assistant, system-ui, sans-serif",
    "source": "https://fonts.googleapis.com/css2?family=Assistant:wght@400;600;700;800&display=swap",
    "license": "OFL",
    "weight": { "body": 400, "label": 600, "button": 700, "heading": 800 },
    "size_px": { "body": 16, "small": 14, "hint": 13, "h1_mobile": 30, "h1_desktop": 48, "price": 22 },
    "numbers": { "font-variant-numeric": "tabular-nums", "direction": "ltr", "unicode-bidi": "isolate" }
  },
  "radius_px": { "button": 10, "field": 10, "card": 14 },
  "space_px": { "gutter_mobile": 16, "section": 32, "field_gap": 14 },
  "button": {
    "primary": { "bg": "#1cb3cf", "fg": "#ffffff", "hover_bg": "#08485d", "disabled_opacity": 0.45, "height_px": 52 },
    "secondary": { "bg": "#ffffff", "fg": "#313131", "border": "#d1d1d1", "hover_border": "#1cb3cf" },
    "whatsapp_float": { "size_px": 56, "bg": "#25d366", "offset_px": 16, "position": "bottom-left (RTL: right side stays free for the primary button)" }
  },
  "field": {
    "default": { "bg": "#ffffff", "border": "#d1d1d1", "fg": "#313131" },
    "focus": { "border": "#1cb3cf", "shadow": "0 0 0 3px rgba(28,179,207,0.25)" },
    "error": { "border": "#f26554", "message_color": "#f26554", "message_size_px": 14, "placement": "below the field, live while typing" },
    "valid": { "mark": "✓", "color": "#086862" },
    "range": { "accent": "#1cb3cf" }
  },
  "status": {
    "estimate_tag": { "bg": "rgba(242,101,84,0.12)", "fg": "#f26554", "text": "משוער" },
    "error_text": "#f26554",
    "warning_text": "#f26554",
    "success_text": "#086862"
  },
  "preview": { "sheet_fill": "rgba(28,179,207,0.06)", "sheet_stroke": "#d1d1d1", "cut_stroke": "#1cb3cf", "engrave_stroke": "#08485d", "duplicate_stroke": "#f26554", "dimension_text": "#626262" },
  "motion": {
    "build_ms": 600, "fill_ms": 400, "tilt_deg": 10, "easing": "cubic-bezier(.16,1,.3,1)",
    "reduced_motion": "everything appears immediately",
    "allowed": ["parametric build (stroke-dashoffset)", "fill (CSS opacity)", "tilt 10deg on drag/hover"],
    "forbidden": ["3D", "rotation", "particles", "per-product animation"]
  },
  "price": { "currency_prefix": "₪", "vat_display": "inclusive", "business_note": "לפני מע״מ ₪{ex}", "estimate_until": "rates.status === 'confirmed'" }
